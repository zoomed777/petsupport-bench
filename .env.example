# ============================================================
# PetSupport-Bench 环境变量样例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，严禁提交！
# ============================================================

# ---- Hy3（OpenAI 兼容接口）----
# 本地 vLLM/SGLang 部署示例：http://127.0.0.1:8000/v1
# TokenHub 在线接口（本次最终实验使用）
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=60
# 本地上下文预算：UTF-8字节代理量，含4096输出预留；不是Hy3精确tokenizer
HY3_CONTEXT_BUDGET_UNITS=24000

# ---- 以下为旧客服系统的兼容配置，最终 Streamlit / final_eval 路径不读取 ----
# ---- LLM Fallback（可选）----
SUPPORT_AGENT_BACKUP_LLM_ENABLED=false
SUPPORT_AGENT_BACKUP_LLM_MODEL=
SUPPORT_AGENT_BACKUP_LLM_BASE_URL=
SUPPORT_AGENT_BACKUP_LLM_API_KEY=
SUPPORT_AGENT_BACKUP_LLM_TIMEOUT_SECONDS=60

# ---- Mock 业务 API（订单/物流/CRM）----
CRM_API_BASE_URL=http://127.0.0.1:8011
OMS_API_BASE_URL=http://127.0.0.1:8011
LOGISTICS_API_BASE_URL=http://127.0.0.1:8011
EXTERNAL_API_TIMEOUT_SECONDS=8

# ---- Agent 身份 token（与后端代理一致，本地演示可留空）----
SUPPORT_AGENT_TOKEN=

# ---- 旧评测配置（最终 Judge 复用上面的 HY3_*，不读取 EVAL_JUDGE_*）----
EVAL_JUDGE_MODEL=hy3
EVAL_JUDGE_BASE_URL=http://127.0.0.1:8000/v1
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_RUNS=3

# ---- Redis（可选，不用则使用内存会话）----
REDIS_URL=
REDIS_SESSION_TTL_SECONDS=3600

# ---- 上下文窗口管理 ----
SUPPORT_AGENT_CONTEXT_TOKEN_LIMIT=6000
